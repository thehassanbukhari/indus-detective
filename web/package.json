{
  "name": "indus-detective-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync-data": "if [ -d ../data/build ]; then mkdir -p public/data && cp ../data/build/trends.json ../data/build/series.json public/data/; fi",
    "dev": "npm run sync-data && vite",
    "build": "npm run sync-data && vite build",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
